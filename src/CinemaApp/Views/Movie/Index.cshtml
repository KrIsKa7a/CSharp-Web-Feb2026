@using CinemaApp.Web.ViewModels.Movie
@using static CinemaApp.GCommon.ErrorMessages.Movie

@model MovieIndexViewModel

@if (TempData[nameof(AddToWatchListNotSuccessfullMessage)] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData[nameof(AddToWatchListNotSuccessfullMessage)]
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="text-light fw-bold">Explore Movies</h1>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary fw-bold">
            <i class="bi bi-arrow-left"></i> Back to Home Page
        </a>
    </div>
    
    <!-- Search Form -->
    <form asp-area="" asp-controller="Movie" asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="searchQuery"
                   class="form-control"
                   placeholder="Search by title..."
                   value="@ViewData["SearchQuery"]" />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    <div class="d-flex flex-column gap-2">
        @foreach (MoviesIndexEntryViewModel movie in Model.Movies)
        {
            <div class="card shadow-lg border-0 rounded-3 d-flex flex-row align-items-center p-2"
                 style="height: 140px; max-height: 140px;">

                <img src="@movie.ImageUrl" class="rounded"
                     alt="@movie.Title"
                     style="width: 100px; height: 130px; object-fit: cover;">

                <div class="card-body ms-3 p-2 text-light" style="flex-grow: 1;">
                    <h6 class="fw-bold mb-1 text-dark">@movie.Title</h6>
                    <p class="text-muted mb-0" style="font-size: 0.85rem;">
                        <strong>Genre:</strong> @movie.Genre |
                        <strong>Director:</strong> @movie.Director
                    </p>
                    <p class="text-muted mb-1" style="font-size: 0.85rem;">
                        <strong>Released:</strong> @movie.ReleaseDate
                    </p>
                </div>

                <div class="me-3 d-flex gap-2">
                    <a asp-area="" asp-controller="Movie" asp-action="Details"
                       asp-route-id="@movie.Id"
                       class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">
                        <i class="bi bi-eye"></i>  View Details
                    </a>

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        @if (movie.IsInUserWatchlist)
                        {
                            <form asp-controller="Watchlist" asp-action="Remove" asp-route-returnUrl="@Url.Action("Index", "Movie")" method="post" class="d-inline">
                                <input type="hidden" name="Id" value="@movie.Id" />
                                <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                                    <i class="bi bi-trash"></i> Remove from Watchlist
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Watchlist" asp-action="Add" method="post" class="d-inline">
                                <input type="hidden" name="Id" value="@movie.Id" />
                                <button class="btn btn-outline-warning btn-sm rounded-pill px-3 add-to-watchlist-btn"
                                        data-movie-id="@movie.Id">
                                    <i class="bi bi-bookmark-heart"></i> Add to Watchlist
                                </button>
                            </form>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (User?.Identity?.IsAuthenticated ?? false)
{
    @if (Model.IsUserManager)
    {
        <a asp-action="Create" class="btn btn-primary">Add New Movie</a>
    }
}
